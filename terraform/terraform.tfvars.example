# Set to the public IPv4 address used for the EKS API, e.g. 203.0.113.9/32.
# Keep your actual value in terraform.tfvars (ignored by Git).
cluster_admin_cidr = "203.0.113.9/32"
name = "relaydesk-capstone"
aws_region = "ap-south-1"
node_instance_types = ["t3.medium"]
node_desired_size = 2
node_min_size = 2
node_max_size = 2
